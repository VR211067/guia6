@model Biblioteca.Models.Autor
@{ ViewData["Title"] = "Eliminar autor"; }
<h1>Eliminar autor</h1><h3>¿Está seguro de eliminar este registro?</h3><hr /><dl class="row"><dt class="col-sm-2">@Html.DisplayNameFor(x => x.Nombre)</dt><dd class="col-sm-10">@Model.Nombre</dd><dt class="col-sm-2">@Html.DisplayNameFor(x => x.Apellido)</dt><dd class="col-sm-10">@Model.Apellido</dd></dl><form asp-action="Delete"><input type="hidden" asp-for="Id" /><button class="btn btn-danger">Eliminar</button> <a asp-action="Index" class="btn btn-secondary">Volver</a></form>
