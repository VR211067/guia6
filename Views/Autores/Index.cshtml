@model IEnumerable<Biblioteca.Models.Autor>
@{ ViewData["Title"] = "Autores"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Autores</h1><a asp-action="Create" class="btn btn-primary">Nuevo autor</a></div>
<table class="table table-striped table-hover"><thead><tr><th>@Html.DisplayNameFor(x => x.Nombre)</th><th>@Html.DisplayNameFor(x => x.Apellido)</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Nombre</td><td>@item.Apellido</td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a> <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalles</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a></td></tr> }
</tbody></table>
