@model Biblioteca.Models.Autor
@{ ViewData["Title"] = "Detalles del autor"; }
<h1>Detalles del autor</h1><hr /><dl class="row"><dt class="col-sm-2">@Html.DisplayNameFor(x => x.Nombre)</dt><dd class="col-sm-10">@Model.Nombre</dd><dt class="col-sm-2">@Html.DisplayNameFor(x => x.Apellido)</dt><dd class="col-sm-10">@Model.Apellido</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a> <a asp-action="Index" class="btn btn-secondary">Volver</a>
