@model Biblioteca.Models.Libro
@{ ViewData["Title"] = "Detalles del libro"; }
<h1>Detalles del libro</h1><hr /><dl class="row"><dt class="col-sm-3">Título</dt><dd class="col-sm-9">@Model.Titulo</dd><dt class="col-sm-3">Fecha de publicación</dt><dd class="col-sm-9">@Model.FechaPublicacion.ToString("dd/MM/yyyy")</dd><dt class="col-sm-3">Autor</dt><dd class="col-sm-9">@Model.Autor?.Nombre @Model.Autor?.Apellido</dd><dt class="col-sm-3">Categoría</dt><dd class="col-sm-9">@Model.Categoria?.Nombre</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a> <a asp-action="Index" class="btn btn-secondary">Volver</a>
