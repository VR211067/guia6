@model IEnumerable<Biblioteca.Models.Libro>
@{ ViewData["Title"] = "Libros"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Libros</h1><a asp-action="Create" class="btn btn-primary">Nuevo libro</a></div><table class="table table-striped table-hover"><thead><tr><th>Título</th><th>Fecha de publicación</th><th>Autor</th><th>Categoría</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Titulo</td><td>@item.FechaPublicacion.ToString("dd/MM/yyyy")</td><td>@item.Autor?.Nombre @item.Autor?.Apellido</td><td>@item.Categoria?.Nombre</td><td class="text-end text-nowrap"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a> <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalles</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a></td></tr> }</tbody></table>
