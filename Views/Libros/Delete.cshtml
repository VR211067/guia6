@model Biblioteca.Models.Libro
@{ ViewData["Title"] = "Eliminar libro"; }
<h1>Eliminar libro</h1><h3>¿Está seguro de eliminar este registro?</h3><hr /><dl class="row"><dt class="col-sm-3">Título</dt><dd class="col-sm-9">@Model.Titulo</dd><dt class="col-sm-3">Fecha de publicación</dt><dd class="col-sm-9">@Model.FechaPublicacion.ToString("dd/MM/yyyy")</dd><dt class="col-sm-3">Autor</dt><dd class="col-sm-9">@Model.Autor?.Nombre @Model.Autor?.Apellido</dd><dt class="col-sm-3">Categoría</dt><dd class="col-sm-9">@Model.Categoria?.Nombre</dd></dl><form asp-action="Delete"><input type="hidden" asp-for="Id" /><button class="btn btn-danger">Eliminar</button> <a asp-action="Index" class="btn btn-secondary">Volver</a></form>
