@model Biblioteca.Models.Categoria
@{ ViewData["Title"] = "Detalles de la categoría"; }
<h1>Detalles de la categoría</h1><hr /><dl class="row"><dt class="col-sm-2">@Html.DisplayNameFor(x => x.Nombre)</dt><dd class="col-sm-10">@Model.Nombre</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a> <a asp-action="Index" class="btn btn-secondary">Volver</a>
